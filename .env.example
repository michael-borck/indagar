# Copy to .env and fill in the providers you have.

# Search: first configured provider in this order wins.
INDAGAR_SEARCH_ORDER=firecrawl,brave,serper,searxng

# Firecrawl: self-hosted is fine and can be keyless.
FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=

# Keyed search providers.
BRAVE_API_KEY=
SERPER_API_KEY=

# Self-hosted SearXNG.
# SEARXNG_URL=http://127.0.0.1:8888

# LLM providers for the next phase.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Budgets.
INDAGAR_MAX_SOURCES=12
INDAGAR_MAX_SECONDS=300
INDAGAR_SEARCH_LIMIT=8
